# Stage 1: Build static assets with npm cache layer
FROM node:20-alpine AS builder
WORKDIR /app

# Copy package files first for better layer caching
COPY frontend/package*.json ./

# Use npm ci (reproducible builds) and cache npm packages
RUN --mount=type=cache,target=/root/.npm npm ci --cache /root/.npm --prefer-offline

# Copy source and build
COPY frontend/ .
RUN npm run build

# Stage 2: Serve via Nginx (minimal runtime)
FROM nginx:alpine

# Add curl for healthchecks
RUN apk add --no-cache curl

# Copy optimized nginx config
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root nginx user (nginx user already exists in image)
RUN touch /var/run/nginx.pid && chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx

USER nginx

EXPOSE 80

# Use exec form to handle signals properly
CMD ["nginx", "-g", "daemon off;"]
