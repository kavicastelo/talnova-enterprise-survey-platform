# Stage 1: Build Jar (Maven cache optimization)
FROM eclipse-temurin:21-jdk-alpine AS builder
ARG SERVICE_NAME
WORKDIR /app

# Install Maven directly to prevent parallel wrapper download/unzip conflicts
RUN apk add --no-cache maven

# Copy root pom and module source code
COPY pom.xml .
COPY shared ./shared
COPY services ./services

# Build targeted service and its dependencies
RUN --mount=type=cache,target=/root/.m2 mvn clean package -pl services/${SERVICE_NAME} -am -DskipTests -q

# Stage 2: Runtime Image (minimal, security-hardened)
FROM eclipse-temurin:21-jre-alpine

# Install dumb-init for proper signal handling and optional healthcheck tools
RUN apk add --no-cache dumb-init curl

WORKDIR /app

# Create non-root user with minimal privileges
RUN addgroup -S tesp && adduser -S -H tesp -G tesp && chown -R tesp:tesp /app

USER tesp:tesp

ARG SERVICE_NAME

# Copy built JAR from builder stage
COPY --from=builder --chown=tesp:tesp /app/services/${SERVICE_NAME}/target/*.jar app.jar

EXPOSE 8080

# Use dumb-init to handle signals properly (graceful shutdown)
ENTRYPOINT ["dumb-init", "--"]
CMD ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-XX:+UseStringDeduplication", "-XX:+ParallelRefProcEnabled", "-XX:+UnlockExperimentalVMOptions", "-XX:+DisableExplicitGC", "-jar", "app.jar"]
