# ============================================================
# TESP DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# ------------------------------------------------------------
# Application & Profile
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
DEFAULT_PROJECT_ID=PRJ-DEFAULT-001

# ------------------------------------------------------------
# Infrastructure Services (Docker Containers)
# ------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=YOUR_LOCAL_MONGO_PASSWORD
MONGODB_HOST=mongodb
MONGODB_PORT=27017

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------
JWT_SECRET=YOUR_DEVELOPMENT_JWT_SECRET_KEY_MIN_256_BITS
AWS_KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/tesp-csfle-key
CORS_ALLOWED_ORIGINS=https://tesp.talnova.io,http://localhost:3000,http://localhost:80

# ------------------------------------------------------------
# Frontend & API Ingress URLs
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
VITE_API_GATEWAY_URL=/api/v1

# ------------------------------------------------------------
# Storage & Cloud Integration
# ------------------------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET_NAME=tesp-report-exports

# ------------------------------------------------------------
# External AI Integration
# ------------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ------------------------------------------------------------
# Microservice Database URIs (Docker Compose Interpolation)
# ------------------------------------------------------------
PROJECT_CONFIG_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_config_db?authSource=admin
ORGANIZATION_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_org_db?authSource=admin
EMPLOYEE_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_employee_db?authSource=admin
SURVEY_BUILDER_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_survey_db?authSource=admin
SURVEY_DISTRIBUTION_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_dist_db?authSource=admin
RESPONSE_INGESTION_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_ingest_db?authSource=admin
ANALYTICS_ENGINE_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_analytics_db?authSource=admin
AI_ANALYTICS_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_ai_db?authSource=admin
REPORTING_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_report_db?authSource=admin
ACTION_PLANNING_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_action_db?authSource=admin
AUDIT_MONGODB_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongodb:27017/tesp_audit_db?authSource=admin
